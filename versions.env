# Inputs pinned by this repo. Run `make pin` to refresh the image digests.
NGINX_VERSION=1.25.5
UPSTREAM_IMAGE=nginx:1.25-bookworm
UPSTREAM_DIGEST=sha256:a484819eb60211f5299034ac80f6a681b06f89e65866ce91f356ed7c72af059c
BUILD_BASE_IMAGE=debian:bookworm-slim
BUILD_BASE_DIGEST=sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# From-source build pins (nginx tarball + nginx's own Debian packaging).
# pkg-oss 14d7f18 (2024-04-30) is nginx 1.25.5-1 + njs 0.8.4 packaging release 3:
# exactly the package revisions the upstream image ships (its env says
# PKG_RELEASE=1~bookworm, NJS_RELEASE=3~bookworm). The 1.25.5-1 tag is one njs
# release older; the only other changes in between are Ubuntu-24-only flags and
# the removal of the (unused) ModSecurity module.
NGINX_SHA512=4a069ec08af46e42a72e263291fc84a67605d817ece1ea7092a5da5babced96ef27eb370ad6f7558b2f5973406080240080aaf4b27fc2d8b41f6853601563cb7
PKG_OSS_REF=14d7f18
PKG_OSS_COMMIT=14d7f1843e9ab69df6d36c3057a0a886f3813ccd

# njs dynamic module: version must match what pkg-oss pins; the SHA-512 is for
# the official GitHub release tarball, used only if nginx's contrib mirror is down.
NJS_VERSION=0.8.4
NJS_GITHUB_SHA512=450f6866141f6f370767149c8749e84c4373f401d6d2237ca85365a851ebe7bdbd8a3c25e85a55747673e8bef2238a979dd237d5fc5c641b2f3f2cf7f26dffc8

# Version-bump source: the exact Debian PCRE2 source version we rebuild. Debian
# drops old versions from its live archive when newer updates land, so the build
# falls back to snapshot.debian.org (immutable) at this timestamp if needed.
PCRE2_VERSION=10.42-1+deb12u2
PCRE2_SNAPSHOT=20261107T060000Z
