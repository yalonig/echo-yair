# syntax=docker/dockerfile:1
# Build the version-bumped PCRE2 .deb from source in a clean Debian base.
ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}
ENV OUT_DIR=/out DEBIAN_FRONTEND=noninteractive
COPY build-pcre2.sh /usr/local/bin/build-pcre2.sh
RUN chmod +x /usr/local/bin/build-pcre2.sh && /usr/local/bin/build-pcre2.sh
